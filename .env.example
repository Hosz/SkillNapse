# ==========================================
# SkillNapse API - Configurações de Ambiente
# ==========================================

# Banco de Dados PostgreSQL (se não usar os padrões localhost:5432)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=skillnapse
# DB_USER=postgres
# DB_PASSWORD=postgres

# Chave JWT (Segredo para assinatura dos tokens)
JWT_SECRET=I2mOO9icKex+FOd4yQP1Mo0lsinZItg2ZksZtxDJfoc=

# Provedor Principal de IA (padrão: gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------
# Fallback Multi-Provedor (Caso a cota diária do Gemini esgote)
# ------------------------------------------
# Ative para ligar o fallback automático:
AI_FALLBACK_ENABLED=true

# Provedor preferencial do fallback ("groq" ou "gemini")
# Se ambos estiverem configurados com chaves, o sistema tenta primeiro o preferencial.
# Caso ele também falhe ou atinja limite, tenta automaticamente o segundo antes de avisar o usuário!
AI_FALLBACK_PROVIDER=groq

# Provedor 1: Groq Cloud (100% Gratuito na nuvem, ~14.400 req/dia, chips LPU ultravelozes)
AI_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
AI_FALLBACK_API_KEY=gsk_sua_chave_groq_aqui
AI_FALLBACK_MODEL=openai/gpt-oss-120b

# Provedor 2: Conta secundária do Google Gemini (Chave de uma segunda conta Google)
GEMINI_FALLBACK_API_KEY=sua_segunda_chave_gemini_aqui
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# (Opcional) OpenRouter Cloud ou Ollama Local:
# Se quiser usar OpenRouter para modelos livres na nuvem:
# AI_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# AI_FALLBACK_API_KEY=sk-or-v1-sua_chave_openrouter
# AI_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free
